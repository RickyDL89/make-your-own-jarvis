# JARVIS settings. run.bat / run.sh asks for the two keys on the first run and fills them in for you.

# THE VOICE: your Fish Audio API key  ->  https://ariacodez.ai/l/fish-audio  (profile > API Keys > Create)
FISH_API_KEY=

# THE BRAIN: your free OpenRouter API key  ->  https://openrouter.ai/keys  (sign up and create a key)
OPENROUTER_API_KEY=

# Which Fish Audio voice JARVIS speaks with. Paste any voice ID from the Fish Audio library.
#   41f0953d7a6b4c078445c7e65d620eeb   JARVIS (the default)
#   612b878b113047d9a770c069c8b4fdfe   Jarvis (MCU)
#   98655a12fa944e26b274c535e5e03842   E-girl (or just say "activate e-girl mode")
FISH_VOICE_ID=41f0953d7a6b4c078445c7e65d620eeb

# Fish Audio speech model. s2.1-pro-free is S2.1 Pro at $0, free until November 30, 2026.
# After that, change it to s2.1-pro (pay-as-you-go).
FISH_MODEL=s2.1-pro-free

# The model JARVIS thinks with. Any model ID from https://openrouter.ai/models works.
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# Which brain: "claude" uses Claude Code (install it and run `claude` once to sign in; no daily limit,
# billed to your Claude plan), "openrouter" uses the key above. Empty means Claude Code if it's installed.
BRAIN=
# The Claude model for conversation. Haiku is quick, which matters when every reply is spoken.
CLAUDE_MODEL=claude-haiku-5-5
# The Claude model for agents and tasks, where quality matters more than speed.
CLAUDE_AGENT_MODEL=claude-opus-5-5

# Taking over ("EDI, take over: ..."): Claude Code does the task with tools.
# The folder it works in (it won't write outside it). Empty means your home folder.
EDI_TASK_DIR=
# Which tools it may use, comma-separated Claude Code permission rules. Empty means the built-in safe list
# (read, search, edit and write files; git status/diff/log/add/commit; python, node, npm; web search).
EDI_TASK_TOOLS=
# Extra tools a task gets only after you say "confirm" to something destructive. Empty means the built-in list
# (PowerShell, rm/del/Remove-Item, mv/move/rename, all of git, winget, taskkill).
EDI_TASK_TOOLS_CONFIRMED=
# Seconds before a task is cut off. The Operator is told this budget and plans around it.
EDI_TASK_TIMEOUT=900

# What JARVIS calls you
JARVIS_CALLS_YOU=sir

# Your city, for the weather (for example: Johannesburg). Empty means EDI works it out from your connection.
EDI_LOCATION=

# Calendar and mail, read-only, no sign-in flow:
#   GOOGLE_CALENDAR_ICS  Google Calendar > Settings > your calendar > "Secret address in iCal format" (several: comma-separated)
#   GMAIL_ADDRESS + GMAIL_APP_PASSWORD  Google Account > Security > 2-Step Verification > App passwords > create one for EDI
GOOGLE_CALENDAR_ICS=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: real web search. Without it EDI uses Google News and Wikipedia, which cover news, sport and facts.
# Free key (2,000 searches a month) at https://brave.com/search/api
BRAVE_API_KEY=

# Local port. If it's busy, JARVIS picks the next free one.
PORT=8765
